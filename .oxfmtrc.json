{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "semi": false,
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/__generated__/**",
    "**/*.generated.ts",
    "packages/*/migrations/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    ".worktrees/**",
    "oxlint-rules/anti-slop/**"
  ]
}
