{
  "name": "@kinesin/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --pretty false",
    "typecheck:tests": "tsc -b --pretty false tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "lint": "NODE_OPTIONS='--import tsx' oxlint",
    "migrate": "node dist/bin/migrate.js",
    "relay": "node dist/relay.js",
    "worker": "node dist/worker.js",
    "publish-cli": "node dist/bin/publish.js",
    "ui": "node dist/ui.js"
  },
  "dependencies": {
    "@kinesin/sdk": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
