{
  "name": "@kyuworks/sdk",
  "version": "0.1.0",
  "description": "Kyu client SDK: publish through a transactional outbox, subscribe with Hatchet, run durable handlers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyuworks/kyu.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "typecheck:tests": "tsc -b --pretty false tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "NODE_OPTIONS='--import tsx' oxlint"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.33.1",
    "@kyuworks/schemas": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "^8.23.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
